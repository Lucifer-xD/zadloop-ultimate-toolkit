{
  "name": "dsh-zadloop-computer-use",
  "version": "1.1.1",
  "description": "Safe, observable Windows computer control for ZadLoop agents with screenshots, mouse, keyboard, and an expiring arm switch.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "zadloop",
    "dsh",
    "computer-use",
    "desktop-automation",
    "windows",
    "vision"
  ],
  "license": "MIT",
  "author": "Lucifer-xD"
}

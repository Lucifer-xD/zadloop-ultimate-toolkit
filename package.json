{
  "name": "dsh-zadloop-ultimate-toolkit",
  "version": "1.9.0",
  "description": "One-install ZadLoop toolkit: secure remote control, computer use, Context Surgery, Undo, mode switching, session transfer, and 72 modern themes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@wasd258/dsh-context-surgery": "file:vendor/wasd258-dsh-context-surgery-0.1.2-zadloop-fixed-v4.tgz",
    "dsh-zadloop-computer-use": "file:vendor/dsh-zadloop-computer-use-1.1.1.tgz",
    "dsh-zadloop-mode-switcher": "file:vendor/dsh-zadloop-mode-switcher-2.0.3.tgz",
    "dsh-zadloop-remote-control-v223": "file:vendor/dsh-zadloop-remote-control-v223-2.2.3.tgz",
    "dsh-zadloop-session-transfer": "file:vendor/dsh-zadloop-session-transfer-1.2.0.tgz",
    "dsh-zadloop-theme-studio-v530": "file:vendor/dsh-zadloop-theme-studio-v530-5.3.0.tgz",
    "dsh-zadloop-undo": "file:vendor/dsh-zadloop-undo-1.5.1.tgz",
    "fflate": "file:vendor/fflate-0.8.3.tgz"
  },
  "bundledDependencies": [
    "@wasd258/dsh-context-surgery",
    "dsh-zadloop-mode-switcher",
    "dsh-zadloop-computer-use",
    "dsh-zadloop-remote-control-v223",
    "dsh-zadloop-session-transfer",
    "dsh-zadloop-theme-studio-v530",
    "dsh-zadloop-undo",
    "fflate"
  ],
  "scripts": {
    "check": "node --check lib/index.js && npm --prefix packages/computer-use run check && npm --prefix packages/remote-control run check && npm --prefix packages/session-transfer run check",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "zadloop",
    "dsh",
    "dsh-plugin",
    "context-surgery",
    "undo",
    "themes",
    "session-transfer",
    "agent-mode",
    "computer-use",
    "remote-control",
    "cloudflare-tunnel"
  ],
  "license": "MIT",
  "author": "Lucifer-xD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lucifer-xD/zadloop-ultimate-toolkit.git"
  },
  "homepage": "https://github.com/Lucifer-xD/zadloop-ultimate-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Lucifer-xD/zadloop-ultimate-toolkit/issues"
  }
}
